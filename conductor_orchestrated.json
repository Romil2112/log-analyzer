{
  "name": "log_analyzer_soc_pipeline_orchestrated",
  "description": "Orchestrated SOC pipeline: detection FORK_JOIN -> SWITCH/TERMINATE (short-circuit on zero incidents) -> GeoIP enrichment -> output FORK_JOIN (Claude summary + AI agent + Sigma rules + ES ingest + GCS upload in parallel) -> severity SWITCH -> optional WAIT human-approval gate for CRITICAL incidents -> SOC-Dashboard push. Uses SWITCH, TERMINATE, WAIT, and two FORK_JOIN task types.",
  "version": 1,
  "schemaVersion": 2,
  "ownerEmail": "shahromil71321@gmail.com",
  "timeoutSeconds": 0,
  "inputParameters": [
    "log_path",
    "soc_url",
    "soc_api_key",
    "es_host",
    "gcs_bucket"
  ],
  "tasks": [
    {
      "name": "detect_fork",
      "taskReferenceName": "detect_fork_ref",
      "type": "FORK_JOIN",
      "forkTasks": [
        [
          {
            "name": "detect_brute_force",
            "taskReferenceName": "bf_ref",
            "type": "SIMPLE",
            "inputParameters": {
              "log_path": "${workflow.input.log_path}",
              "log_format": "auto"
            }
          }
        ],
        [
          {
            "name": "detect_port_scan",
            "taskReferenceName": "ps_ref",
            "type": "SIMPLE",
            "inputParameters": {
              "log_path": "${workflow.input.log_path}",
              "log_format": "auto"
            }
          }
        ],
        [
          {
            "name": "detect_404_flood",
            "taskReferenceName": "flood_ref",
            "type": "SIMPLE",
            "inputParameters": {
              "log_path": "${workflow.input.log_path}",
              "log_format": "auto"
            }
          }
        ],
        [
          {
            "name": "ml_score",
            "taskReferenceName": "ml_ref",
            "type": "SIMPLE",
            "inputParameters": {
              "log_path": "${workflow.input.log_path}",
              "log_format": "auto"
            }
          }
        ]
      ]
    },
    {
      "name": "detect_join",
      "taskReferenceName": "detect_join_ref",
      "type": "JOIN",
      "joinOn": [
        "bf_ref",
        "ps_ref",
        "flood_ref",
        "ml_ref"
      ]
    },
    {
      "name": "join_incidents",
      "taskReferenceName": "join_ref",
      "type": "SIMPLE",
      "inputParameters": {
        "brute": "${bf_ref.output.incidents}",
        "port": "${ps_ref.output.incidents}",
        "flood": "${flood_ref.output.incidents}",
        "anomaly_scores": "${ml_ref.output.anomaly_scores}",
        "events": "${ml_ref.output.events}"
      }
    },
    {
      "name": "incident_count_switch",
      "taskReferenceName": "count_switch_ref",
      "type": "SWITCH",
      "evaluatorType": "javascript",
      "expression": "$.incident_count === 0 ? 'no_incidents' : 'has_incidents'",
      "inputParameters": {
        "incident_count": "${join_ref.output.counts.incidents}"
      },
      "decisionCases": {
        "no_incidents": [
          {
            "name": "terminate_no_threats",
            "taskReferenceName": "terminate_no_threats_ref",
            "type": "TERMINATE",
            "inputParameters": {
              "terminationStatus": "COMPLETED",
              "terminationReason": "no_threats_detected"
            }
          }
        ]
      },
      "defaultCase": []
    },
    {
      "name": "enrich_geoip",
      "taskReferenceName": "enrich_ref",
      "type": "SIMPLE",
      "inputParameters": {
        "incidents": "${join_ref.output.incidents}",
        "anomaly_scores": "${join_ref.output.anomaly_scores}"
      }
    },
    {
      "name": "output_fork",
      "taskReferenceName": "output_fork_ref",
      "type": "FORK_JOIN",
      "forkTasks": [
        [
          {
            "name": "generate_claude_summary",
            "taskReferenceName": "summary_ref",
            "type": "SIMPLE",
            "inputParameters": {
              "incidents": "${enrich_ref.output.incidents}",
              "anomaly_scores": "${join_ref.output.anomaly_scores}"
            }
          }
        ],
        [
          {
            "name": "run_ai_agent",
            "taskReferenceName": "agent_ref",
            "type": "SIMPLE",
            "inputParameters": {
              "incidents": "${enrich_ref.output.incidents}",
              "anomaly_scores": "${join_ref.output.anomaly_scores}"
            }
          }
        ],
        [
          {
            "name": "generate_sigma_rules",
            "taskReferenceName": "sigma_ref",
            "type": "SIMPLE",
            "inputParameters": {
              "incidents": "${enrich_ref.output.incidents}"
            }
          }
        ],
        [
          {
            "name": "elasticsearch_ingest",
            "taskReferenceName": "es_ref",
            "type": "SIMPLE",
            "inputParameters": {
              "incidents": "${enrich_ref.output.incidents}",
              "es_host": "${workflow.input.es_host}",
              "log_path": "${workflow.input.log_path}"
            }
          }
        ],
        [
          {
            "name": "gcs_upload_report",
            "taskReferenceName": "gcs_ref",
            "type": "SIMPLE",
            "inputParameters": {
              "incidents": "${enrich_ref.output.incidents}",
              "gcs_bucket": "${workflow.input.gcs_bucket}",
              "log_path": "${workflow.input.log_path}"
            }
          }
        ]
      ]
    },
    {
      "name": "output_join",
      "taskReferenceName": "output_join_ref",
      "type": "JOIN",
      "joinOn": [
        "summary_ref",
        "agent_ref",
        "sigma_ref",
        "es_ref",
        "gcs_ref"
      ]
    },
    {
      "name": "severity_route_switch",
      "taskReferenceName": "severity_switch_ref",
      "type": "SWITCH",
      "evaluatorType": "javascript",
      "expression": "$.incidents.some(function(i) { return i.severity === 'CRITICAL'; }) ? 'critical' : 'non_critical'",
      "inputParameters": {
        "incidents": "${enrich_ref.output.incidents}"
      },
      "decisionCases": {
        "critical": [
          {
            "name": "human_approval_wait",
            "taskReferenceName": "approval_wait_ref",
            "type": "WAIT",
            "inputParameters": {
              "workflow_id": "${workflow.workflowId}"
            },
            "taskDefinition": {
              "name": "human_approval_wait",
              "timeoutSeconds": 14400,
              "timeoutPolicy": "ALERT_ONLY",
              "retryCount": 0
            }
          }
        ],
        "non_critical": []
      },
      "defaultCase": []
    },
    {
      "name": "push_to_dashboard",
      "taskReferenceName": "push_ref",
      "type": "SIMPLE",
      "inputParameters": {
        "incidents": "${enrich_ref.output.incidents}",
        "soc_url": "${workflow.input.soc_url}",
        "soc_api_key": "${workflow.input.soc_api_key}",
        "workflow_id": "${workflow.workflowId}"
      }
    }
  ],
  "outputParameters": {
    "counts": "${join_ref.output.counts}",
    "summary": "${summary_ref.output.summary}",
    "agent_report": "${agent_ref.output.report}",
    "sigma_files": "${sigma_ref.output.files}",
    "sigma_count": "${sigma_ref.output.count}",
    "es_indexed": "${es_ref.output.indexed}",
    "gcs_uploaded": "${gcs_ref.output.uploaded}",
    "approval_note": "${approval_wait_ref.output.note}",
    "pushed": "${push_ref.output.pushed}",
    "push_errors": "${push_ref.output.errors}"
  }
}
