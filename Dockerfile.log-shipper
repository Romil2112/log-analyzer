FROM golang:1.21-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ ./cmd/
COPY internal/ ./internal/
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /log-shipper ./cmd/log-shipper

FROM alpine:3.19
RUN addgroup -S shipper && adduser -S shipper -G shipper
USER shipper
COPY --from=builder /log-shipper /usr/local/bin/log-shipper
ENTRYPOINT ["log-shipper"]
